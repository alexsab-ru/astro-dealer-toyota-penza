---
import Layout from '@/layouts/Layout.astro';
import settings from '@/data/site/settings.json';
import modelsData from '@/data/site/models.json';
import PageH1 from '@/ui/page-h1/PageH1.astro';
import Button from '@/ui/button/Button.astro';
import { Icon } from 'astro-icon/components';

const { brand, legal_city_where } = settings;
const files = [
	{
		name: 'Camry',
		url: 'https://cdn.alexsab.ru/manuals/toyota/penza/manual-toyota-camry.pdf',
		size: '19.3 МБ',
		format: 'PDF'
	},
	{
		name: 'Avalon',
		url: 'https://cdn.alexsab.ru/manuals/toyota/penza/manual-toyota-avalon.pdf',
		size: '17.2 МБ',
		format: 'PDF'
	},
	{
		name: 'RAV4',
		url: 'https://cdn.alexsab.ru/manuals/toyota/penza/manual-toyota-rav4.pdf',
		size: '17.7 МБ',
		format: 'PDF'
	}
];
---

<Layout title={`Руководства по эксплуатации автомобилей ${brand} – Официальный дилер ${brand} в ${legal_city_where}`} description={`Посмотрите или скачайте официальные руководства по эксплуатации автомобилей ${brand}. Полезная информация для владельцев: инструкции по вождению, эксплуатацииб технические характеристики автомобилей от официального дилера ${brand} в ${legal_city_where}.`}>
	<div class="container py-10 xl:py-16 content">
		<PageH1 h1={`Руководства по эксплуатации ${brand}`} classes="text-3xl mb-10! sm:text-4xl font-bold text-center" />

		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-7">
			{files.map((model) => (
				<div class="flex flex-col rounded-2xl border border-gray-200 bg-white shadow-sm hover:shadow-md transition-shadow overflow-hidden">
					<div class="flex items-center gap-4 bg-gray-50 border-b border-gray-200 px-5 py-4">
						<Icon name="mdi:file-pdf-box" class="text-red-500 shrink-0 text-5xl" />
						<div>
							<p class="text-xs text-gray-400 uppercase tracking-wide font-medium mb-0.5">Руководство по эксплуатации</p>
							<h2 class="m-0! p-0! before:hidden text-lg! font-semibold leading-tight">{model.name}</h2>
						</div>
					</div>
					<div class="flex items-center gap-3 px-5 py-3 text-sm text-gray-500">
						<span class="inline-flex items-center gap-1">
							<Icon name="mdi:tag-outline" class="text-base shrink-0" />
							{model.format}
						</span>
						<span class="text-gray-300">·</span>
						<span class="inline-flex items-center gap-1">
							<Icon name="mdi:weight" class="text-base shrink-0" />
							{model.size}
						</span>
					</div>
					<div class="px-5 pb-5 mt-auto">
						<Button view="link" classes="w-full! m-0! btn justify-center!" url={model.url} target="_blank" title="Открыть PDF" />
					</div>
				</div>
			))}
		</div>
	</div>
</Layout>