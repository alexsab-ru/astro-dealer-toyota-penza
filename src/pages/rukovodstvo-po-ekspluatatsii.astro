---
import Layout from '@/layouts/Layout.astro';
import settings from '@/data/settings.json';
import PageH1 from '@/components/PageH1/Index.astro';
import Button from '@/components/Button/Button.astro';

const { brand, legal_city_where } = settings;
const files = [
	{
		name: 'Camry',
		url: 'https://cdn.alexsab.ru/manuals/toyota/penza/manual-toyota-camry.pdf',
	},
	{
		name: 'Avalon',
		url: 'https://cdn.alexsab.ru/manuals/toyota/penza/manual-toyota-avalon.pdf'
	},
	{
		name: 'RAV4',
		url: 'https://cdn.alexsab.ru/manuals/toyota/penza/manual-toyota-rav4.pdf'
	}
];
---

<Layout title={`Руководства по эксплуатации автомобилей ${brand} – Официальный дилер ${brand} в ${legal_city_where}`} description={`Посмотрите или скачайте официальные руководства по эксплуатации автомобилей ${brand}. Полезная информация для владельцев: инструкции по вождению, эксплуатацииб технические характеристики автомобилей от официального дилера ${brand} в ${legal_city_where}.`}>
	<div class="container py-10 space-y-10 xl:space-y-14 content">
		<PageH1 h1={`Руководства по эксплуатации ${brand}`} classes="text-3xl mb-12! sm:text-4xl font-bold text-center" />

		{files.map((model) => (
				<div>
						<h2 class="mb-6! p-0! before:hidden text-xl! lg:text-3xl!">Руководство по эксплуатации <span class="font-semibold">{model.name}</span></h2>
						<div class="flex gap-3">
							<Button view="link" classes="m-0! btn" url={model.url} target="_blank" title="Посмотреть" />
							<Button view="link" classes="m-0! btn btn-o" url={model.url} download title="Скачать"/>
						</div>
				</div>
			)
		)}
		
	</div>
</Layout>